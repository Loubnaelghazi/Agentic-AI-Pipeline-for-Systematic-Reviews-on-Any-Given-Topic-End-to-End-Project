# Local Python and CLI defaults
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
# 0 reserves GPU memory for the LLM on 8 GB cards; -1 lets Ollama decide.
EMBEDDING_NUM_GPU=0
OLLAMA_NUM_CTX=8192
# Extra reasoning for disputed eligibility only, when supported by the model.
OLLAMA_AUDIT_REASONING=true
OLLAMA_REQUEST_TIMEOUT=300
OLLAMA_RETRY_ATTEMPTS=2
RERANK_ENABLED=true
AI_PLANNER_ENABLED=true
# DATA_DIR=/absolute/path/to/data

# Docker: backend connects to Ollama on the host; browser calls the published API.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Set these to your host user's UID/GID if they differ from 1000.
LOCAL_UID=1000
LOCAL_GID=1000

# Optional OpenAlex metadata API key; never used for paid full-text endpoints.
OPENALEX_API_KEY=

# Optional: private WSL address when Ollama runs inside WSL; otherwise leave blank.
OLLAMA_HOST_ADDRESS=
